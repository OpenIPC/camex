#
# camex.conf.example — example server-side parameter database
#
# [server]     — server runtime parameters (override CLI defaults).
#                CLI arguments always take priority over these values.
# [defaults]   — default profile applied to every client unless overridden.
# [client ID]  — per-client profile; ID = MAC address or any unique string.
#
# Per-client sections override [defaults].
# The optional "psk" field sets a per-client pre-shared key (passphrase).
# Clients without a "psk" entry authenticate using the global psk.
# Having both a global PSK and per-client PSKs is supported simultaneously.
#

[server]
# port=5800
# bind_ip=0.0.0.0
# local_cidr=10.0.0.1/24
# mtu=1500
# encrypt=yes
# psk=global-server-passphrase
# tun_dev=camex0
# bind_dev=eth0
# pid_file=/var/run/camex.pid

[defaults]
local_cidr=10.0.0.1/24
gateway_ip=10.0.0.1
mtu=1500
route_cidr=192.168.100.0/24
route_cidr=192.168.101.0/24

[client 0203A104B5AE]
local_cidr=10.0.0.2/24
gateway_ip=10.0.0.1
route_cidr=192.168.200.0/24
# psk=per-client-secret-for-this-device

[client ABCDEF123456]
local_cidr=10.0.0.3/24
gateway_ip=10.0.0.1
psk=unique-passphrase-for-ABCDEF123456
