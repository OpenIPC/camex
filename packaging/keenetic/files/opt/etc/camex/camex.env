#
# camex.env — settings for /opt/etc/init.d/S99camex (Keenetic / Entware)
#
# DRAFT (issue #33): validate on a real router before relying on it.
#
# 1. Set ENABLED=yes.
# 2. Pick one ARGS line below and fill in the server address, port and key.
# 3. /opt/etc/init.d/S99camex start   (logs: KeeneticOS system log)
#

ENABLED=no

# Client, auto mode: the server pushes the tunnel address, gateway and routes.
#ARGS="--mode client --auto --name KEENETIC01 --server-host vpn.example.com --port 5800 --encrypt --psk change-me"

# Client, manual mode.
#ARGS="--mode client --server-host vpn.example.com --port 5800 --local-cidr 10.0.0.2/24 --gateway-ip 10.0.0.1 --route-cidr 192.168.200.0/24 --encrypt --psk change-me"

# Server: clients and their addresses are listed in /opt/etc/camex/camex.conf.
#ARGS="--mode server --port 5800 --local-cidr 10.0.0.1/24 --config /opt/etc/camex/camex.conf --encrypt --psk change-me"

# Tunnel interface for the netfilter hook (/opt/etc/ndm/netfilter.d/50-camex.sh).
# camex takes the first free tunN name; the log line "Tunnel device: tunN" shows it.
# The default matches every tunN interface.
CAMEX_IFACE="tun+"
