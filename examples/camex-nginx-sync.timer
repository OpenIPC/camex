#
# Installed as: /etc/systemd/system/camex-nginx-sync.timer
# Docs: https://github.com/OpenIPC/camex/blob/master/docs/nginx.md#sync-script
#

[Unit]
Description=Update the nginx map of camex clients every 10 seconds

[Timer]
OnBootSec=30s
OnUnitActiveSec=10s
AccuracySec=1s

[Install]
WantedBy=timers.target
