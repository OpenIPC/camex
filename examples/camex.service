#
# camex.service — systemd service unit for camex tunnel daemon
#
# Install:
#   sudo cp camex.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable camex
#   sudo systemctl start camex
#
# For client mode with auto-config:
#   Environment="CAMEX_ARGS=--mode client --auto --name 0203A104B5AE \
#     --server-host vpn.example.org --port 7000 --encrypt --psk secret"
#
# For server mode:
#   Environment="CAMEX_ARGS=--mode server --port 7000 \
#     --config /etc/camex/camex.conf --encrypt --psk secret"
#

[Unit]
Description=Camex VPN Tunnel Daemon
Documentation=https://github.com/OpenIPC/camex
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/camex $CAMEX_ARGS
Environment=CAMEX_ARGS=--mode client --auto --name 0203A104B5AE --server-host vpn.example.org --port 7000
Restart=on-failure
RestartSec=5
LimitNOFILE=1024
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_IPC_LOCK
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_IPC_LOCK
MemoryDenyWriteExecute=true
PrivateTmp=true

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictRealtime=yes

[Install]
WantedBy=multi-user.target
