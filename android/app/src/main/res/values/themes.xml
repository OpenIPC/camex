    themes.xml — camex in brass (brand brass 1.4.0), dark day and night: platform Material,
    no AppCompat or Material Components (#55)
-->
<resources>
    <style name="Theme.Camex" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorPrimary">@color/panel</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:colorAccent">@color/amber</item>
        <item name="android:colorControlNormal">@color/dim</item>
        <item name="android:colorControlActivated">@color/amber</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/dim</item>
        <item name="android:textColorHint">#99b09873</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <!-- brass check boxes and radio buttons (brass 1.4.0): own drawings that show on and
             off under the remote's focus, the focus ring around the row -->
        <item name="android:checkboxStyle">@style/BrassCheck</item>
        <item name="android:radioButtonStyle">@style/BrassRadio</item>
    </style>
    <style name="BrassCheck" parent="android:Widget.Material.CompoundButton.CheckBox">
        <item name="android:background">@drawable/focus_ring</item>
        <item name="android:button">@drawable/brass_check</item>
        <item name="android:buttonTint">@null</item>
        <!-- 6dp between the drawing and the text, and after the text: the focus ring does
             not lie on the last letter (brass 1.4.0, after pusher 0.22.4) -->
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingLeft">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:paddingRight">6dp</item>
    </style>
    <style name="BrassRadio" parent="android:Widget.Material.CompoundButton.RadioButton">
        <item name="android:background">@drawable/focus_ring</item>
        <item name="android:button">@drawable/brass_radio</item>
        <item name="android:buttonTint">@null</item>
        <!-- 6dp between the drawing and the text, and after the text: the focus ring does
             not lie on the last letter (brass 1.4.0, after pusher 0.22.4) -->
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingLeft">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:paddingRight">6dp</item>
    </style>
    <style name="Brass" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/brass_button</item>
        <item name="android:textColor">@color/ink_dark</item>
        <!-- 13sp, 0.1: SETTINGS in Brass Serif, wider than the system serif, keeps to one
             line in a third of a 360dp phone (brass 1.5.1) -->
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
