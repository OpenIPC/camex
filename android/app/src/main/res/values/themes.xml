    themes.xml — camex in brass (brand brass 1.3.0), dark day and night: platform Material,
    no AppCompat or Material Components (#55)
-->
<resources>
    <style name="Theme.Camex" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorPrimary">@color/panel</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:colorAccent">@color/amber</item>
        <item name="android:colorControlNormal">@color/dim</item>
        <item name="android:colorControlActivated">@color/amber</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/dim</item>
        <item name="android:textColorHint">#99b09873</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <!-- the D-pad focus of check boxes and radio buttons (brass focus_ring.xml) -->
        <item name="android:checkboxStyle">@style/Check</item>
        <item name="android:radioButtonStyle">@style/Radio</item>
    </style>
    <style name="Check" parent="android:Widget.Material.CompoundButton.CheckBox">
        <item name="android:background">@drawable/focus_ring</item>
    </style>
    <style name="Radio" parent="android:Widget.Material.CompoundButton.RadioButton">
        <item name="android:background">@drawable/focus_ring</item>
    </style>
    <style name="Brass" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/brass_button</item>
        <item name="android:textColor">@color/ink_dark</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.15</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
