#
# Dockerfile.smoke — minimal Alpine runtime for camex smoke tests
#
# Build: docker build -f Dockerfile.smoke -t camex:smoke .
# Usage: docker run --rm --cap-add NET_ADMIN --device /dev/net/tun camex:smoke --help
#

FROM ubuntu:24.04

RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
    libc6 iptables 2>/dev/null || true && \
    rm -rf /var/lib/apt/lists/*

COPY camex /usr/local/bin/camex

ENTRYPOINT ["/usr/local/bin/camex"]
